# ── Database ───────────────────────────────────────────────────────────
# Development lokal (Postgres di host / container terpisah):
DATABASE_URL="postgresql://fleetuser:fleetpass@localhost:5432/fleetops_db?schema=public"

# ── Identitas aplikasi (tampil di header, manifest PWA, dan judul halaman) ──
NEXT_PUBLIC_APP_NAME="FleetOps ERP"
NEXT_PUBLIC_COMPANY_NAME="PT Forklift Solusindo Utama"

# ── Seed (hanya untuk development) ─────────────────────────────────────
# Kata sandi untuk akun dummy. Jika kosong, seed memakai nilai bawaan di prisma/seed.ts.
# Seed menolak berjalan saat NODE_ENV=production kecuali ALLOW_SEED=true.
SEED_DEFAULT_PASSWORD=""
ALLOW_SEED="false"
